{
  "name": "ai-web-clients",
  "version": "1.0.0",
  "description": "AI Web Clients Monorepo",
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=11.6.0"
  },
  "packageManager": "npm@12.2.0",
  "main": "index.js",
  "scripts": {
    "graph": "nx graph",
    "version": "nx release version",
    "version:dry-run": "nx release version --dry-run",
    "release": "nx release",
    "release:dry-run": "nx release --dry-run",
    "publish": "nx release publish",
    "publish:dry-run": "nx release publish --dry-run",
    "dev:react": "nx serve react-integration-tests",
    "dev:mock:arh": "node apps/client-integration-tests/arh-mock-server.js",
    "dev:mock:lsc": "node apps/client-integration-tests/lightspeed-mock-server.js",
    "dev:mock:alsc": "node apps/client-integration-tests/ansible-lightspeed-mock-server.js",
    "dev:mock:aai": "node apps/client-integration-tests/aai-mock-server.js",
    "dev:mock:rls": "node apps/client-integration-tests/rhel-lightspeed-mock-server.js",
    "dev:mock:mas": "node apps/client-integration-tests/mas-mock-server.js",
    "dev:mock": "concurrently \"npm run dev:mock:arh\" \"npm run dev:mock:lsc\" \"npm run dev:mock:alsc\" \"npm run dev:mock:aai\" \"npm run dev:mock:rls\" \"npm run dev:mock:mas\"",
    "cypress:open": "cypress open --project apps/react-integration-tests-e2e",
    "cypress:run": "cypress run --project apps/react-integration-tests-e2e",
    "e2e": "concurrently \"npm run dev:react\" \"npm run dev:mock\" \"npm run cypress:run\"",
    "e2e:open": "npm run cypress:open"
  },
  "keywords": [
    "monorepo",
    "nx",
    "react",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@nx/cypress": "^22.7.12",
    "@nx/devkit": "^22.7.12",
    "@nx/eslint": "^22.7.12",
    "@nx/eslint-plugin": "^22.7.12",
    "@nx/jest": "^22.7.12",
    "@nx/js": "^22.7.12",
    "@nx/react": "^22.7.12",
    "@nx/rollup": "^22.7.12",
    "@nx/vite": "^22.7.12",
    "@nx/web": "^22.7.12",
    "@nx/workspace": "^22.7.12",
    "@rollup/plugin-url": "^8.0.2",
    "@svgr/rollup": "^8.1.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.18",
    "@swc/helpers": "~0.5.23",
    "@swc/jest": "~0.2.39",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^3.2.7",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.2.5",
    "core-js": "^3.50.0",
    "cypress": "^15.21.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.2",
    "jest-environment-node": "^29.7.0",
    "jiti": "2.7.0",
    "jsdom": "~22.1.0",
    "jsonc-eslint-parser": "^2.4.2",
    "nx": "^22.7.12",
    "prettier": "^2.8.8",
    "rollup": "^4.64.6",
    "sass": "^1.105.1",
    "swc-loader": "0.2.7",
    "ts-jest": "^29.4.14",
    "ts-node": "10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "verdaccio": "^6.10.5",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "nx": {
      "brace-expansion": "^5.0.9"
    },
    "dompurify": "^3.4.14"
  },
  "dependencies": {
    "@patternfly/chatbot": "^6.7.1",
    "@patternfly/react-core": "^6.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uuid": "^11.1.1"
  }
}
